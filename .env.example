ASKDOC_APP_NAME=AskDoc
ASKDOC_ENVIRONMENT=local
ASKDOC_DOCUMENTS_STORAGE_PATH=.data/documents
ASKDOC_RABBITMQ_URL=amqp://guest:guest@localhost:5672//
ASKDOC_DOCUMENT_CHUNK_SIZE=500
ASKDOC_DOCUMENT_CHUNK_OVERLAP=100
ASKDOC_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ASKDOC_DATABASE_URL=postgresql+psycopg://askdoc:askdoc@localhost:5432/askdoc
ASKDOC_LLM_PROVIDER=ollama
ASKDOC_LLM_MODEL=llama3.2
ASKDOC_LLM_BASE_URL=http://localhost:11434/v1
ASKDOC_LLM_API_KEY=ollama

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
POSTGRES_DEFAULT_USER=askdoc
POSTGRES_DEFAULT_PASS=askdoc
POSTGRES_DEFAULT_DB=askdoc
